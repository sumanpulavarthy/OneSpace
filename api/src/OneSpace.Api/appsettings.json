{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "ConnectionString": "",
    "DatabaseName": "onespace",
    "QueryLogRetentionDays": 30,
    "ConversationRetentionHours": 24
  },
  "Assistant": {
    "Engine": "Llm",
    "Chain": [ "anthropic" ],
    "Providers": {
      "anthropic": {
        "Type": "Anthropic",
        "Model": "claude-opus-5-5",
        "MaxDataClass": "Personal"
      }
    },
    "MaxTokens": 4096,
    "Effort": "Low",
    "MaxToolRounds": 5,
    "MaxHistoryChars": 6000,
    "ToolSelection": true,
    "RequireCertifiedModels": true,
    "Routing": {
      "Enabled": true,
      "EscalateOnGroundingFailure": true
    },
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "BreakDuration": "00:01:00"
    }
  },
  "Retrieval": {
    "Embeddings": {
      "Type": "None",
      "Model": "",
      "MaxDataClass": "Internal"
    },
    "VectorStore": "BruteForce",
    "ChunkSize": 800,
    "ChunkOverlap": 100,
    "VectorCandidates": 8,
    "MinSimilarity": 0.3
  },
  "Integrations": {
    "ZohoMcp": {
      "Endpoint": "",
      "ProtocolVersion": "2025-06-18",
      "OAuth": {
        "Scopes": [
          "zohopeople.leave.all",
          "zohopeople.attendance.all",
          "ZohoMCP.tool.execute"
        ],
        "RedirectUri": "",
        "PostConnectRedirectUri": "/assistant"
      }
    },
    "Microsoft365": {
      "TenantId": "",
      "ClientId": ""
    },
    "ComplyKaro": {
      "Mode": "Sample",
      "SampleFile": "SeedData/policies.sample.json"
    }
  },
  "PolicySync": {
    "Enabled": true,
    "Interval": "1.00:00:00",
    "RunOnStartup": true
  },
  "DataProtection": {
    "KeyVaultKeyUri": ""
  }
}
