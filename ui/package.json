{
  "name": "onespace-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "codegen": "graphql-codegen --config codegen.ts",
    "prestart": "npm run codegen",
    "start": "ng serve --port 4200 --proxy-config proxy.conf.json",
    "prebuild": "npm run codegen",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run codegen",
    "test": "jest --config jest.config.js",
    "test:ci": "npm run codegen && jest --config jest.config.js --ci --coverage --watchAll=false",
    "typecheck": "npm run codegen && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0",
    "@azure/msal-browser": "5.25.0",
    "@angular/platform-browser-dynamic": "^20.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.10",
    "@angular/cli": "^20.3.10",
    "@angular/compiler-cli": "^20.3.0",
    "typescript": "~5.9.2",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "graphql": "^16.11.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "^14.6.2",
    "@graphql-codegen/add": "^5.0.3"
  }
}
